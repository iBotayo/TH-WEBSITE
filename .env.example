# ThinkingHead Nigeria Limited — Environment Configuration Template
# Copy this file to .env.local for local development.

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=https://thinkinghead.ng

# --- Lead Persistence Configuration ---
# Current implementation: development_logging (in-memory / console log)
# Production provider (PostgreSQL, Supabase, CRM) remains pending business approval
LEAD_STORAGE_PROVIDER=development_logging

# --- Notification Configuration ---
# Production providers remain pending business selection (e.g. SMTP/API, WhatsApp Business API)
NOTIFICATION_RECIPIENT_EMAIL=thinkingheadng@gmail.com
SYSTEM_FROM_EMAIL=hello@thinkinghead.ng
