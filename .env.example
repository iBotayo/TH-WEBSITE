# ThinkingHead Nigeria Limited — Environment Configuration Template
# Copy this file to .env.local for local development.

# --- Lead Persistence Configuration ---
# Options: development_logging (default for dev/staging) | pending_approval
LEAD_STORAGE_PROVIDER=development_logging

# --- Email Dispatch Configuration ---
# Production provider pending business selection (e.g. Resend, Postmark, SendGrid)
EMAIL_PROVIDER_API_KEY=
# Documented primary recipient for discovery leads (strictly from BRD):
NOTIFICATION_RECIPIENT_EMAIL=thinkingheadng@gmail.com
SYSTEM_FROM_EMAIL=no-reply@thinkinghead.ng

# --- WhatsApp Alert Configuration ---
# Provider pending business selection (e.g. Twilio, Meta Cloud API)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_RECIPIENT_PHONE=

# --- Slack Webhook Configuration (Optional / Pending Decision) ---
SLACK_WEBHOOK_URL=

# --- Analytics (Public Client Tokens) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# --- Maps Configuration ---
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
